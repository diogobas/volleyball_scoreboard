{
  "name": "volleyball-scoreboard",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/game/*.test.js src/remote/*.test.js supabase/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "build:public": "vite build --mode public",
    "preview:public": "vite preview --outDir dist-public",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "site:prepare": "npm run build:public && node scripts/prepare-cloudflare.mjs",
    "site:check": "npm exec --yes --package=cf@1.0.0-beta.28 -- cf deploy --prebuilt --mode public --dry-run",
    "site:deploy": "npm exec --yes --package=cf@1.0.0-beta.28 -- cf deploy --prebuilt --mode public",
    "site:publish:github": "python3 scripts/publish-github-pages.py",
    "verify:remote": "node scripts/check-public-backend.mjs",
    "site:pages:check": "node scripts/publish-pages.mjs",
    "site:pages:deploy": "node scripts/publish-pages.mjs --upload"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.6.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "vite": "^8.3.5"
  }
}
